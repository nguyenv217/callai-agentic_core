    mock_tool_call = MagicMock()
    mock_tool_call.model_dump.return_value = {
        "id": "call_123",
        "type": "function",
        "function": {"name": "get_weather", "arguments": '{"location": "Tokyo"}'}
    }
    mock_message.tool_calls = [mock_tool_call]

    mock_choice = MagicMock()
